# Example environment file for Rockwell API
# Copy this to .env and fill in your actual values

# System Configuration
SYSTEM=wakati
PRODUCT=api
ENVIRONMENT=dev
PORT=8080

# Database Configuration
DATABASE_URL='postgres://postgres:password@localhost:5432/nesting'

# Supabase Configuration
SUPABASE_URL='https://your-project.supabase.co'
SUPABASE_ANON_KEY='your-anon-key'
SUPABASE_SERVICE_ROLE_KEY='your-service-role-key'
SUPABASE_JWT_SECRET='your-jwt-secret'
SUPABASE_BUCKETNAME='assets'
SUPABASE_TOKEN_OVERRIDE='your-token-override'

# API Keys
RESEND_APIKEY='your-resend-api-key'
CRUD_API_TOKEN='your-crud-api-token'

# Inngest Configuration
INNGEST_API_KEY='your-inngest-api-key'
INNGEST_EVENT_KEY='your-inngest-event-key'
INNGEST_SIGNING_KEY='your-inngest-signing-key'

# Monitoring & Observability
NEW_RELIC_LICENSE_KEY='your-new-relic-license-key'
OTEL_EXPORTER_OTLP_ENDPOINT='your-otel-endpoint'
OTEL_EXPORTER_OTLP_HEADERS='your-otel-headers'

# AI/ML Services
OPENAI_API_KEY='your-openai-api-key'

# Optional: Redis URL
REDIS_URL='redis://localhost:6379'

# AWS Configuration
AWS_ACCESS_KEY_ID='your-aws-access-key'
AWS_SECRET_ACCESS_KEY='your-aws-secret-key'
AWS_REGION='us-east-1'
AWS_S3_BUCKET_NAME='your-bucket-name'
AWS_CLOUDFRONT_DOMAIN='your-cloudfront-domain'
AWS_ACCOUNT_ID='your-aws-account-id'ELEVENLABS_API_KEY=your_api_key_here
