{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": "swc",
    "plugins": [
      "@nestjs/swagger"
    ],
    "assets": [
      {
        "include": "**/*.graphql"
      }
    ]
  },
  "sourceMap": false
}