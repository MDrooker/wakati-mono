  "scripts": {
    "docker:build": "docker build --build-arg NPM_TOKEN=$NPM_TOKEN --platform linux/amd64,linux/arm64 -t matthewjon/sparrow-api . && docker push matthewjon/sparrow-api",
    "docker:build-conversion": "./build-docker.sh",
    "docker:run": "docker run -d -p 8080:8080 -e INNGEST_BASE_URL=http://host.docker.internal:8288  --platform linux/amd64 -t matthewjon/sparrow-api",
    "docker:run-conversion": "docker-compose -f docker-compose.conversion.yml up",
    "docker:health-check": "docker exec $(docker ps -q --filter ancestor=rockwell-api) ./docker-health-check.sh",
    "build": "nest build",
    "postbuild": "rimraf dist/**/*.map",
    "types": "npx ts-node --logError src/generate-types.ts",
    "code": "graphql-codegen",
    "bundle": "mkdir -p gqlbundle && find \"$(pwd)/src\" -type f -name \"*.graphql\" -exec cp {} ./gqlbundle \\;",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "debug": "./debug-start.sh",
    "test:db": "node test-db-connection.js",
    "health": "curl -s http://localhost:8080/health | jq .",
    "bun:prod": "bun dist/main",
    "bun:dev": "bun --watch src/main.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
  },
