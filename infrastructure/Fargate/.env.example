# Environment Configuration
# Copy this file to .env and update with your values

# AWS Configuration
AWS_ACCOUNT_ID=your-aws-account-id
AWS_REGION=us-east-1

# Stack Configuration
STACK_NAME=RockwellFargateStack
ENVIRONMENT=dev
ECR_STACK_NAME=RockwellEcrStack

# CDK Configuration
CDK_DEFAULT_ACCOUNT=your-aws-account-id
CDK_DEFAULT_REGION=us-east-1

# Application Configuration (stored in AWS Systems Manager Parameter Store)
# These should be created manually in AWS console or via CLI:
# aws ssm put-parameter --name "/rockwell/database-url" --value "your-db-url" --type "SecureString"
# aws ssm put-parameter --name "/rockwell/supabase-url" --value "your-supabase-url" --type "SecureString"
# aws ssm put-parameter --name "/rockwell/supabase-anon-key" --value "your-supabase-key" --type "SecureString"
# aws ssm put-parameter --name "/rockwell/jwt-secret" --value "your-jwt-secret" --type "SecureString"
